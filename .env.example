# 複製成 .env（已被 .gitignore 忽略）後填入「dev 專案」的值，絕對不要填正式環境的金鑰
SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
SUPABASE_KEY=dev-project-service-role-key
SECRET_KEY=change-me-to-a-random-hex-string
FLASK_DEBUG=true

# 本機 http 開發才需要關閉；正式環境不要設（預設為 Secure）
SESSION_COOKIE_SECURE=false

# 註冊白名單：只有這些 Email 能在 /teacher/register 註冊（逗號分隔；不設 = 關閉註冊）
REGISTER_ALLOWED_EMAILS=you@example.com
